# Optional local ONNX model. Leave blank for reliable context-only mode.
ASTRANEX_MODEL_PATH=
ASTRANEX_AUTO_DOWNLOAD_MODEL=1
ASTRANEX_MODEL_REPO=AbhiCommits/cropguard-models
ASTRANEX_MODEL_FILENAME=cropguard.onnx
# Comma-separated allowed browser origins for deployment.
ASTRANEX_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Set to 1 to force the bundled state-vector simulator even when Qiskit is installed.
ASTRANEX_FORCE_FALLBACK_SIM=0
